{
  "id": "nodebb-plugin-variedmc-rules",
  "name": "VariedMC Rules",
  "description": "Board governance, trace-required delete requests, and trust marks for VariedMCForum",
  "url": "https://github.com/VariedMCForum/VariedMCForum",
  "library": "./library.js",
  "settingsRoute": "/admin/plugins/variedmc-rules",
  "hooks": [
    { "hook": "static:app.load", "method": "init" },
    { "hook": "filter:admin.header.build", "method": "addAdminNavigation" },
    { "hook": "filter:config.get", "method": "appendConfig" },
    { "hook": "filter:topic.post", "method": "filterTopicPost" },
    { "hook": "filter:post.edit", "method": "filterPostEdit" },
    { "hook": "filter:topic.delete", "method": "filterTopicDelete" },
    { "hook": "filter:topic.restore", "method": "filterTopicRestore" },
    { "hook": "filter:privileges.topics.get", "method": "filterPrivilegesTopicsGet" },
    { "hook": "filter:post.delete", "method": "filterPostDelete" },
    { "hook": "filter:post.tools", "method": "filterPostTools" },
    { "hook": "filter:topic.thread_tools", "method": "filterThreadTools" },
    { "hook": "filter:category.get", "method": "filterCategoryGet" },
    { "hook": "filter:posts.modifyUserInfo", "method": "filterModifyUserInfo" }
  ],
  "modules": {
    "../admin/plugins/variedmc-rules.js": "public/js/admin.js"
  },
  "scripts": [
    "public/js/client/rule-policy.js",
    "public/js/client/review-preview.js",
    "public/js/client/edit-review.js",
    "public/js/client.js"
  ],
  "acpScss": [
    "public/scss/style.scss"
  ],
  "scss": [
    "public/scss/style.scss"
  ],
  "templates": "templates",
  "languages": "languages",
  "compatibility": "^4.0.0"
}
