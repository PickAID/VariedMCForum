{
	"id": "nodebb-plugin-tag-controller",
	"name": "Tag Controller",
	"description": "Manage tag colors from the ACP",
	"url": "https://github.com/VariedMCForum/VariedMCForum",
	"library": "./library.js",
	"hooks": [
		{ "hook": "static:app.load", "method": "init" },
		{ "hook": "filter:admin.header.build", "method": "addAdminNavigation" },
		{ "hook": "filter:config.get", "method": "appendConfig" }
	],
	"modules": {
		"../admin/plugins/tag-controller.js": "public/js/admin.js"
	},
	"scripts": [
		"public/js/client.js"
	],
	"acpScss": [
		"public/scss/style.scss"
	],
	"scss": [
		"public/scss/style.scss"
	],
	"templates": "templates",
	"compatibility": "^4.0.0"
}
