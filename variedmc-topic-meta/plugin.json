{
	"id": "nodebb-plugin-variedmc-topic-meta",
	"name": "VariedMC Topic Meta",
	"description": "Composer metadata rules and title mapping for VariedMCForum",
	"url": "https://github.com/VariedMCForum/VariedMCForum",
	"library": "./library.js",
	"settingsRoute": "/admin/plugins/variedmc-topic-meta",
	"hooks": [
		{
			"hook": "static:app.load",
			"method": "init"
		},
		{
			"hook": "filter:admin.header.build",
			"method": "addAdminNavigation"
		},
		{
			"hook": "filter:config.get",
			"method": "appendConfig"
		},
		{
			"hook": "filter:composer.push",
			"method": "filterComposerPush"
		},
		{
			"hook": "filter:topic.post",
			"method": "filterTopicPost"
		},
		{
			"hook": "filter:topic.create",
			"method": "filterTopicCreate"
		},
		{
			"hook": "filter:post.edit",
			"method": "filterPostEdit"
		},
		{
			"hook": "filter:topic.edit",
			"method": "filterTopicEdit"
		}
	],
	"modules": {
		"../admin/plugins/variedmc-topic-meta/utils.js": "public/js/admin/utils.js",
		"../admin/plugins/variedmc-topic-meta/list-editor.js": "public/js/admin/list-editor.js",
		"../admin/plugins/variedmc-topic-meta/category-fields.js": "public/js/admin/category-fields.js",
		"../admin/plugins/variedmc-topic-meta/category-rules.js": "public/js/admin/category-rules.js",
		"../admin/plugins/variedmc-topic-meta.js": "public/js/admin.js"
	},
	"scripts": [
		"public/js/client/styles.js",
		"public/js/client/domain.js",
		"public/js/client/title.js",
		"public/js/client/composer-ui.js",
		"public/js/client.js"
	],
	"acpScss": [
		"public/scss/style.scss"
	],
	"scss": [
		"public/scss/style.scss"
	],
	"templates": "templates",
	"languages": "languages",
	"compatibility": "^4.0.0"
}
